---
// Componente de logotipos e insignias vectoriales SVG de alta precisión para universidades e instituciones
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 32, class: className = '' } = Astro.props;
---

<span class={`institution-logo-wrap ${className}`} style={`width: ${size}px; height: ${size}px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;`}>
  {name === 'icesi' && (
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" aria-label="Universidad Icesi" height={size} width={size} viewBox="0 0 48 48"><rect width="48" height="48" fill="#1e6c93" rx="8"/><path fill="#fff" d="M12 14h6v20h-6zm10 6a6 6 0 0 1 12 0h-6v8h6a6 6 0 0 1-12 0z"/><circle cx="36" cy="17" r="3" fill="#f59e0b"/></svg>
  )}

  {name === 'uah' && (
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" aria-label="Universidad de Alcalá" height={size} width={size} viewBox="0 0 48 48"><rect width="48" height="48" fill="#8b1e1e" rx="8"/><path fill="#5c1111" stroke="#f59e0b" stroke-width="2.5" d="m24 8 12 8v10c0 7-12 13-12 13s-12-6-12-13V16z"/><path stroke="#fff" stroke-linecap="round" stroke-width="2" d="M24 14v19m-6-13h12m-11 7h10"/><circle cx="24" cy="14" r="2" fill="#f59e0b"/></svg>
  )}

  {name === 'uao' && (
    <svg width={size} height={size} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Universidad Autónoma de Occidente">
      <rect width="48" height="48" rx="8" fill="#065F46"/>
      <circle cx="24" cy="24" r="14" stroke="#F59E0B" stroke-width="2.5"/>
      <path d="M18 20L24 15L30 20V29L24 33L18 29V20Z" fill="#FFFFFF"/>
      <path d="M24 19L27 25H21L24 19Z" fill="#065F46"/>
    </svg>
  )}

  {name === 'minciencias' && (
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" aria-label="MinCiencias" height={size} width={size} viewBox="0 0 48 48"><rect width="48" height="48" fill="#0f172a" rx="8"/><path stroke="#38bdf8" stroke-linecap="round" stroke-width="3" d="M10 24c0-7.732 6.268-14 14-14s14 6.268 14 14-6.268 14-14 14"/><path stroke="#f59e0b" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="m20 18 8 6-8 6"/><circle cx="24" cy="24" r="3" fill="#fff"/></svg>
  )}

  {name === 'banrep' && (
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" aria-label="Banco de la República" height={size} width={size} viewBox="0 0 48 48"><rect width="48" height="48" fill="#78350f" rx="8"/><circle cx="24" cy="24" r="15" fill="#451a03" stroke="#f59e0b" stroke-width="2"/><path stroke="#fef3c7" stroke-linecap="round" stroke-width="2.5" d="M24 13v22m-6-16c0-2.5 2.5-4 6-4s6 1.5 6 4c0 3-5 4-6 5s-6 2-6 5c0 2.5 2.5 4 6 4s6-1.5 6-4"/></svg>
  )}

  {name === 'linkedin' && (
    <svg width={size} height={size} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="LinkedIn">
      <rect width="48" height="48" rx="8" fill="#0A66C2"/>
      <path d="M15 19H19V33H15V19ZM17 13C15.62 13 14.5 14.12 14.5 15.5C14.5 16.88 15.62 18 17 18C18.38 18 19.5 16.88 19.5 15.5C19.5 14.12 18.38 13 17 13ZM22 19H25.8V20.9H25.9C26.4 19.9 27.7 18.7 29.8 18.7C34 18.7 35 21.4 35 25.1V33H31V25.9C31 24.2 30.9 22 28.5 22C26.1 22 25.7 23.9 25.7 25.8V33H22V19Z" fill="#FFFFFF"/>
    </svg>
  )}

  {name === 'scholar' && (
    <svg width={size} height={size} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Google Scholar">
      <rect width="48" height="48" rx="8" fill="#1E293B"/>
      <path d="M24 11L10 22L24 33L38 22L24 11Z" fill="#4285F4"/>
      <path d="M16 26.7V34.5C16 38.9 24 41 24 41C24 41 32 38.9 32 34.5V26.7L24 33L16 26.7Z" fill="#34A853"/>
      <path d="M37 23.5V33.5H39V22L37 23.5Z" fill="#FBBC05"/>
    </svg>
  )}

  {name === 'repec' && (
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" aria-label="RePEc" height={size} width={size} viewBox="0 0 48 48"><rect width="48" height="48" fill="#1e3a8a" rx="8"/><text x="24" y="27" fill="#f8fafc" font-family="var(--font-sans)" font-size="14" font-weight="900" text-anchor="middle">RePEc</text><path stroke="#f59e0b" stroke-linecap="round" stroke-width="2.5" d="M12 33h24"/></svg>
  )}

  {name === 'stata' && (
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" aria-label="Stata" height={size} width={size} viewBox="0 0 48 48"><rect width="48" height="48" fill="#1c3d5a" rx="8"/><text x="24" y="29" fill="#fff" font-family="var(--font-sans)" font-size="14" font-weight="800" letter-spacing="1" text-anchor="middle">STATA</text></svg>
  )}

  {name === 'r' && (
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" aria-label="R Language" height={size} width={size} viewBox="0 0 48 48"><rect width="48" height="48" fill="#226e93" rx="8"/><circle cx="24" cy="24" r="15" fill="#fff" opacity=".15"/><path fill="#fff" d="M19 15h7c3 0 5 1.5 5 4.5 0 2.5-1.5 4-3.5 4.5l4.5 9h-5l-3.5-8h-1v8H19zm3.5 7h3c1.3 0 2-.7 2-1.8s-.7-1.7-2-1.7h-3z"/></svg>
  )}

  {name === 'python' && (
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" aria-label="Python" height={size} width={size} viewBox="0 0 48 48"><rect width="48" height="48" fill="#0f172a" rx="8"/><path fill="#38bdf8" d="M23.5 11c-5.3 0-5 2.3-5 2.3v2.3h5.3v1.7h-8s-3.8-.4-3.8 4.9 3.3 5.1 3.3 5.1h2.1v-3c0-3.5 2.9-3.5 2.9-3.5h6c3.1 0 3.1-3 3.1-3v-4s.4-2.8-5.9-2.8m-2.2 1.8c.7 0 1.2.6 1.2 1.3s-.5 1.2-1.2 1.2-1.2-.5-1.2-1.2.5-1.3 1.2-1.3"/><path fill="#f59e0b" d="M24.5 37c5.3 0 5-2.3 5-2.3v-2.3h-5.3v-1.7h8s3.8.4 3.8-4.9-3.3-5.1-3.3-5.1h-2.1v3c0 3.5-2.9 3.5-2.9 3.5h-6c-3.1 0-3.1 3-3.1 3v4s-.4 2.8 5.9 2.8m2.2-1.8c-.7 0-1.2-.6-1.2-1.3s.5-1.2 1.2-1.2 1.2.5 1.2 1.2-.5 1.3-1.2 1.3"/></svg>
  )}
</span>
