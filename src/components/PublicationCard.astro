---
interface Props {
  id: string;
  title: string;
  journal: string;
  year: string;
  volume: string;
  authors: string;
  ranking: string;
  area: string;
  abstract: string;
  url: string;
  doi?: string;
}

const { id, title, journal, year, volume, authors, ranking, area, abstract, url, doi } = Astro.props;

const getRankingBadgeClass = (rank: string) => {
  if (rank.includes('Q1')) return 'badge-q1';
  if (rank.includes('Q2')) return 'badge-q2';
  if (rank.includes('Q3')) return 'badge-q3';
  return 'badge-q4';
};

const bibtex = `@article{gonzalez_${id}_${year},
  title = {${title}},
  author = {${authors}},
  journal = {${journal}},
  volume = {${volume}},
  year = {${year}},
  doi = {${doi || ''}},
  url = {${url}}
}`;
---

<article class="card publication-card" style="margin-bottom: 1.5rem;">
  <div class="pub-meta">
    <span class={`badge ${getRankingBadgeClass(ranking)}`}>
      {ranking}
    </span>
    <span class="badge badge-status">
      {area}
    </span>
    <span style="font-size: 0.85rem; color: var(--text-muted); margin-left: auto;">
      {year}
    </span>
  </div>

  <h3 class="pub-title">
    <a href={url} target="_blank" rel="noopener noreferrer">
      {title}
    </a>
  </h3>

  <p class="pub-authors">
    <strong>Autores:</strong> {authors}
  </p>

  <p class="pub-journal">
    {journal}, {volume}
  </p>

  <details style="margin-top: 0.75rem; cursor: pointer;">
    <summary style="font-weight: 600; font-size: 0.88rem; color: var(--accent-primary); user-select: none;">
      Ver Resumen (Abstract)
    </summary>
    <div class="pub-abstract">
      {abstract}
    </div>
  </details>

  <div class="pub-actions">
    <a href={url} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
      Ver Artículo en Journal
    </a>
    <button
      class="btn btn-outline btn-sm copy-bibtex-btn"
      data-bibtex={bibtex}
      title="Copiar cita BibTeX al portapapeles"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      Copiar BibTeX
    </button>
  </div>
</article>

<script>
  function setupBibtexButtons() {
    const buttons = document.querySelectorAll('.copy-bibtex-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const bibtex = btn.getAttribute('data-bibtex');
        if (bibtex) {
          try {
            await navigator.clipboard.writeText(bibtex);
            const originalText = btn.innerHTML;
            btn.innerHTML = `Copiado al portapapeles`;
            setTimeout(() => {
              btn.innerHTML = originalText;
            }, 2000);
          } catch (e) {
            console.error('Error al copiar BibTeX', e);
          }
        }
      });
    });
  }

  setupBibtexButtons();
  document.addEventListener('astro:after-swap', setupBibtexButtons);
</script>
