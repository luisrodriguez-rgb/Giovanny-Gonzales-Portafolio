---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import InstitutionLogo from './InstitutionLogo.astro';

const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { href: '/', labelEs: 'Inicio', labelEn: 'Home' },
  { href: '/research', labelEs: 'Investigación & Publicaciones', labelEn: 'Research & Publications' },
  { href: '/teaching', labelEs: 'Docencia', labelEn: 'Teaching' },
  { href: '/students', labelEs: 'Tesistas & Asesorías', labelEn: 'Students & Advising' },
  { href: '/r-lab', labelEs: 'Laboratorio R', labelEn: 'R & Stata Lab' },
  { href: '/resources', labelEs: 'Recursos', labelEn: 'Resources' },
];
---

<header class="navbar">
  <div class="container navbar-inner">
    <a href="/" class="navbar-brand">
      <InstitutionLogo name="icesi" size={28} />
      <span>Dr. Giovanni González</span>
    </a>

    <nav>
      <ul class="navbar-links">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`navbar-link ${pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href)) ? 'active' : ''}`}
            >
              <span data-lang-es={item.labelEs} data-lang-en={item.labelEn}>
                {item.labelEs}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="navbar-actions">
      <LanguageToggle />
      <ThemeToggle />
    </div>
  </div>
</header>
