---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import InstitutionLogo from './InstitutionLogo.astro';

const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { href: '/research', labelEs: 'Investigación', labelEn: 'Research' },
  { href: '/teaching', labelEs: 'Docencia', labelEn: 'Teaching' },
  { href: '/resources', labelEs: 'Recursos', labelEn: 'Resources' },
  { href: '/about', labelEs: 'Acerca de', labelEn: 'About' },
];
---

<header class="navbar">
  <div class="container navbar-inner">
    <a href="/" class="navbar-brand" title="Inicio | Dr. Carlos Giovanni González">
      <span class="brand-name">GIOVANNI GONZÁLEZ</span>
      <span class="brand-tagline">Economics · Research · Teaching</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul class="navbar-links">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`navbar-link ${pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href)) ? 'active' : ''}`}
            >
              <span data-lang-es={item.labelEs} data-lang-en={item.labelEn}>
                {item.labelEs}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="navbar-actions">
      <LanguageToggle />
      <a
        href="https://www.linkedin.com/in/carlos-giovanni-gonzalez-espitia/"
        target="_blank"
        rel="noopener noreferrer"
        class="navbar-linkedin-link"
        title="Perfil en LinkedIn"
        aria-label="LinkedIn"
      >
        <InstitutionLogo name="linkedin" size={16} />
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
