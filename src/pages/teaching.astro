---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolioData';
import InstitutionLogo from '../components/InstitutionLogo.astro';

const { courses, professor } = portfolioData;
const undergraduateCourses = courses.filter((c) => c.level === 'undergraduate');
const graduateCourses = courses.filter((c) => c.level === 'graduate');
---

<BaseLayout
  title={`Docencia & Cátedras | ${professor.fullName}`}
  description="Cursos universitarios de pregrado y posgrado en econometría, macroeconomía y métodos cuantitativos en la Universidad Icesi."
>
  <div class="container" style="padding: 3.5rem 1.5rem 5rem;">
    <!-- Page Header -->
    <div style="margin-bottom: 3.5rem; max-width: 820px;">
      <span class="badge badge-status" style="margin-bottom: 0.75rem;">
        Academic Teaching Portfolio
      </span>
      <h1 class="font-serif" style="font-size: 2.75rem; line-height: 1.15; margin-bottom: 1rem;">
        Docencia & Cursos Universitarios
      </h1>
      <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.75;">
        Formación rigurosa en econometría, teoría macroeconómica y análisis empírico con laboratorios semanales y microdatos oficiales de Colombia.
      </p>
    </div>

    <!-- Filosofía Docente -->
    <section class="card card-highlight" style="margin-bottom: 4.5rem; padding: 2rem 2.5rem;">
      <h2 class="font-serif" style="font-size: 1.6rem; margin-bottom: 0.5rem;">
        Metodología: Rigor Matemático + Laboratorio Empírico
      </h2>
      <p style="font-size: 0.98rem; color: var(--text-secondary); line-height: 1.75; margin-bottom: 1.25rem;">
        Cada cátedra combina la deducción formal de teoremas y estimadores con el análisis aplicado sobre datos reales del DANE, ICFES y Banco de la República. El objetivo es que los estudiantes dominen tanto la intuición económica como la computación científica reproducible.
      </p>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
        <span class="badge badge-status" style="display: inline-flex; align-items: center; gap: 0.4rem;">
          <InstitutionLogo name="stata" size={16} />
          <span>Stata 18</span>
        </span>
        <span class="badge badge-status" style="display: inline-flex; align-items: center; gap: 0.4rem;">
          <InstitutionLogo name="r" size={16} />
          <span>RStudio / Quarto</span>
        </span>
        <span class="badge badge-status" style="display: inline-flex; align-items: center; gap: 0.4rem;">
          <InstitutionLogo name="python" size={16} />
          <span>Python (Spatial Analysis)</span>
        </span>
      </div>
    </section>

    <!-- 1. Cursos de Pregrado -->
    <section id="undergraduate" style="margin-bottom: 4.5rem;">
      <div style="margin-bottom: 1.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
        <h2 class="font-serif" style="font-size: 1.85rem;">Pregrado en Economía & Finanzas</h2>
        <p style="font-size: 0.92rem; color: var(--text-muted); margin-top: 0.25rem;">
          Cátedras de fundamentación y nivel intermedio-avanzado en la Universidad Icesi.
        </p>
      </div>

      <div style="display: flex; flex-direction: column; gap: 2rem;">
        {undergraduateCourses.map((c) => (
          <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
              <div>
                <span class="badge badge-status font-mono" style="font-size: 0.75rem; margin-right: 0.5rem;">{c.code}</span>
                <span class="badge badge-q2 font-mono" style="font-size: 0.72rem;">{c.semester}</span>
              </div>
              <span style="font-size: 0.85rem; color: var(--text-muted);">{c.degree}</span>
            </div>

            <h3 class="font-serif" style="font-size: 1.45rem; color: var(--text-primary); margin-bottom: 0.75rem;">
              {c.name}
            </h3>

            <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 1.25rem;">
              {c.description}
            </p>

            <div class="grid-2" style="background: var(--bg-tertiary); padding: 1.25rem; border-radius: var(--radius-md); gap: 1.5rem; margin-bottom: 1rem;">
              <div>
                <h4 style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-primary); margin-bottom: 0.5rem;">
                  Objetivos de Aprendizaje:
                </h4>
                <ul style="padding-left: 1.2rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6;">
                  {c.objectives.map((obj) => (
                    <li>{obj}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-primary); margin-bottom: 0.5rem;">
                  Microdatos & Software:
                </h4>
                <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
                  {c.software.map((sw) => (
                    <span class="badge badge-status font-mono" style="font-size: 0.72rem;">{sw}</span>
                  ))}
                </div>
                <p style="font-size: 0.82rem; color: var(--text-muted);">
                  Bases de datos: {c.datasets.join(', ')}
                </p>
              </div>
            </div>

            <div>
              <h4 style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.5rem;">
                Módulos del Syllabus:
              </h4>
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                {c.topics.map((top) => (
                  <span class="badge badge-status" style="font-size: 0.78rem;">
                    {top}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Cursos de Posgrado & MBA -->
    <section id="graduate">
      <div style="margin-bottom: 1.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
        <h2 class="font-serif" style="font-size: 1.85rem;">Posgrados, MBA & Doctorado</h2>
        <p style="font-size: 0.92rem; color: var(--text-muted); margin-top: 0.25rem;">
          Formación gerencial avanzada y seminarios doctorales de investigación cuantitativa.
        </p>
      </div>

      <div style="display: flex; flex-direction: column; gap: 2rem;">
        {graduateCourses.map((c) => (
          <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
              <div>
                <span class="badge badge-status font-mono" style="font-size: 0.75rem; margin-right: 0.5rem;">{c.code}</span>
                <span class="badge badge-q1 font-mono" style="font-size: 0.72rem;">{c.semester}</span>
              </div>
              <span style="font-size: 0.85rem; color: var(--accent-primary); font-weight: 600;">{c.degree}</span>
            </div>

            <h3 class="font-serif" style="font-size: 1.45rem; color: var(--text-primary); margin-bottom: 0.75rem;">
              {c.name}
            </h3>

            <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 1.25rem;">
              {c.description}
            </p>

            <div class="grid-2" style="background: var(--bg-tertiary); padding: 1.25rem; border-radius: var(--radius-md); gap: 1.5rem; margin-bottom: 1rem;">
              <div>
                <h4 style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-primary); margin-bottom: 0.5rem;">
                  Competencias Formativas:
                </h4>
                <ul style="padding-left: 1.2rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6;">
                  {c.objectives.map((obj) => (
                    <li>{obj}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-primary); margin-bottom: 0.5rem;">
                  Herramientas y Fuentes:
                </h4>
                <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
                  {c.software.map((sw) => (
                    <span class="badge badge-status font-mono" style="font-size: 0.72rem;">{sw}</span>
                  ))}
                </div>
                <p style="font-size: 0.82rem; color: var(--text-muted);">
                  {c.datasets.join(', ')}
                </p>
              </div>
            </div>

            <div>
              <h4 style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.5rem;">
                Módulos del Programa:
              </h4>
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                {c.topics.map((top) => (
                  <span class="badge badge-status" style="font-size: 0.78rem;">
                    {top}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
