---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolioData';

const { econometricsWithR } = portfolioData;
---

<BaseLayout
  title="Laboratorio de Econometría con R | Dr. Carlos Giovanni González Espitia"
  description="Recursos de computación estadística, scripts de econometría con R, paquetes recomendados y guías para economistas."
>
  <div class="container" style="padding: 3.5rem 1.5rem 5rem;">
    <div class="section-header">
      <span class="section-tag">Econometría Computacional</span>
      <h1 class="section-title font-serif" style="font-size: 2.75rem;">
        {econometricsWithR.title}
      </h1>
      <p class="section-subtitle" style="max-width: 850px; font-size: 1.15rem;">
        {econometricsWithR.intro}
      </p>
    </div>

    <!-- Featured Module Cards -->
    <div class="grid-2" style="margin-top: 2rem;">
      {econometricsWithR.resources.map((item) => (
        <div class="card card-highlight" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {item.tools.map((tool) => (
                <span class="badge badge-q1 font-mono">{tool}</span>
              ))}
            </div>
            <h3 style="font-size: 1.3rem; margin-bottom: 0.75rem; color: var(--text-primary);">
              {item.title}
            </h3>
            <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 1rem;">
              {item.desc}
            </p>
          </div>
          <div style="border-top: 1px solid var(--border-subtle); padding-top: 0.75rem; font-size: 0.85rem; color: var(--accent-primary); font-weight: 600;">
            ✓ Material replicable & datos abiertos
          </div>
        </div>
      ))}
    </div>

    <!-- Code Snippet Demonstration -->
    <section style="margin-top: 4rem; background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); padding: 2.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="badge badge-status">Script de Muestra</span>
          <h2 class="font-serif" style="font-size: 1.6rem; margin-top: 0.25rem;">
            Estimación de Modelo Durbin Espacial en R
          </h2>
        </div>
        <span class="badge badge-q2 font-mono">R / spatialreg</span>
      </div>

      <pre style="background: var(--bg-tertiary); padding: 1.5rem; border-radius: var(--radius-md); overflow-x: auto; font-family: var(--font-mono); font-size: 0.88rem; line-height: 1.6; border: 1px solid var(--border-subtle); color: var(--text-primary);">
<code># 1. Cargar librerías esenciales para econometría espacial
library(sf)          # Manejo de geometrías y capas espaciales
library(spdep)       # Creación de matrices de pesos espaciales W
library(spatialreg)  # Estimación SAR, SEM y Spatial Durbin Model (SDM)

# 2. Construcción de matriz de contigüidad tipo Reina (Queen)
neighbors &lt;- poly2nb(cali_neighborhoods, queen = TRUE)
W &lt;- nb2listw(neighbors, style = "W", zero.policy = TRUE)

# 3. Estimación del modelo Durbin Espacial (SDM)
# Homicidios ~ Informalidad Laboral + Controles + W*(X)
sdm_model &lt;- lagsarlm(
  homicidios ~ informalidad + desempleo + educacion,
  data = cali_neighborhoods,
  listw = W,
  Durbin = TRUE,
  zero.policy = TRUE
)

# 4. Cálculo de impactos directos, indirectos (spillover) y totales
summary(impacts(sdm_model, listw = W, R = 1000))</code>
      </pre>

      <p style="margin-top: 1rem; font-size: 0.9rem; color: var(--text-muted);">
        * Metodología inspirada en el paper <em>"The Spatial and Economic Relationship Between Labour Informality and Homicides in Cali"</em> (Development Policy Review, 2023).
      </p>
    </section>
  </div>
</BaseLayout>
