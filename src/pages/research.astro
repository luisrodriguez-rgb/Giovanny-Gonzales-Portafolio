---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolioData';
import PublicationCard from '../components/PublicationCard.astro';

const { researchAreas, publications, workingPapers, supervisedStudents } = portfolioData;
---

<BaseLayout
  title="Investigación & Publicaciones | Dr. Carlos Giovanni González Espitia"
  description="Líneas de investigación en economía de la educación, economía del crimen, econometría aplicada y archivo editorial de publicaciones indexadas."
>
  <div class="container" style="padding: 3.5rem 1.5rem 5rem;">
    <!-- Page Header -->
    <div style="margin-bottom: 3.5rem; max-width: 820px;">
      <span class="badge badge-status" style="margin-bottom: 0.75rem;" data-lang-es="Investigación Académica & Archivo" data-lang-en="Research Hub & Archive">
        Investigación Académica & Archivo
      </span>
      <h1 class="font-serif" style="font-size: 2.75rem; line-height: 1.15; margin-bottom: 1rem;" data-lang-es="Investigación & Publicaciones" data-lang-en="Research & Publications">
        Investigación & Publicaciones
      </h1>
      <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.75;" data-lang-es="Investigación cuantitativa aplicada enfocada en evaluación de políticas públicas, dinámicas socioeconómicas territoriales y determinantes de la educación y la seguridad en Colombia." data-lang-en="Applied quantitative research focused on public policy evaluation, territorial socioeconomic dynamics, and determinants of education and security in Colombia.">
        Investigación cuantitativa aplicada enfocada en evaluación de políticas públicas, dinámicas socioeconómicas territoriales y determinantes de la educación y la seguridad en Colombia.
      </p>
    </div>

    <!-- 1. Research Areas Detailed -->
    <section style="margin-bottom: 4.5rem;">
      <div style="margin-bottom: 1.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
        <h2 class="font-serif" style="font-size: 1.85rem;" data-lang-es="Líneas de Investigación (Pillars)" data-lang-en="Research Areas (Pillars)">Líneas de Investigación (Pillars)</h2>
      </div>

      <div class="grid-2">
        {researchAreas.map((area) => (
          <div id={area.id} class="card card-highlight">
            <h3 class="font-serif" style="font-size: 1.35rem; margin-bottom: 0.35rem; color: var(--text-primary);" data-lang-es={area.title.es} data-lang-en={area.title.en}>
              {area.title.es}
            </h3>
            <p style="font-size: 0.9rem; font-weight: 600; color: var(--accent-primary); margin-bottom: 0.75rem;" data-lang-es={area.tagline.es} data-lang-en={area.tagline.en}>
              {area.tagline.es}
            </p>
            <p style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 1rem;" data-lang-es={area.description.es} data-lang-en={area.description.en}>
              {area.description.es}
            </p>
            <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
              {area.keyTopics.map((topic) => (
                <span class="badge badge-status font-mono" style="font-size: 0.72rem;">
                  {topic}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Research Archive con Filtros Editoriales -->
    <section id="publications" style="margin-bottom: 4.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
        <div>
          <h2 class="font-serif" style="font-size: 1.85rem;" data-lang-es="Archivo de Investigaciones" data-lang-en="Research Archive">Research Archive</h2>
          <p style="font-size: 0.92rem; color: var(--text-muted); margin-top: 0.25rem;" data-lang-es="Artículos en revistas científicas indexadas (Scopus / Web of Science) con microdatos y citas BibTeX." data-lang-en="Articles in peer-reviewed indexed scientific journals (Scopus / Web of Science) with microdata and BibTeX citations.">
            Artículos en revistas científicas indexadas (Scopus / Web of Science) con microdatos y citas BibTeX.
          </p>
        </div>
      </div>

      <!-- Filtros Editoriales por Tema -->
      <div class="archive-filter-bar" role="group" aria-label="Filtrar por área de investigación">
        <button type="button" class="filter-btn active" data-filter="all" data-lang-es="TODOS" data-lang-en="ALL">TODOS</button>
        <button type="button" class="filter-btn" data-filter="education" data-lang-es="EDUCACIÓN" data-lang-en="EDUCATION">EDUCACIÓN</button>
        <button type="button" class="filter-btn" data-filter="crime" data-lang-es="CRIMEN & SEGURIDAD" data-lang-en="CRIME & SECURITY">CRIMEN & SEGURIDAD</button>
        <button type="button" class="filter-btn" data-filter="entrepreneurship" data-lang-es="EMPRENDIMIENTO" data-lang-en="ENTREPRENEURSHIP">EMPRENDIMIENTO</button>
      </div>

      <!-- Lista de Publicaciones con data-area para filtrado dinámico -->
      <div class="publications-list">
        {publications.map((pub) => (
          <div class="pub-item" data-area={pub.area}>
            <PublicationCard
              id={pub.id}
              title={pub.title}
              journal={pub.journal}
              year={pub.year.toString()}
              volume={pub.volume}
              authors={pub.authors.join(', ')}
              ranking={pub.ranking}
              area={pub.area}
              abstract={pub.abstract}
              url={pub.url}
              doi={pub.doi}
            />

            <!-- Desglose de Estructura de Investigación (Derived from Abstract) -->
            {pub.researchQuestion && (
              <div class="pub-deep-dive">
                <div class="deep-dive-grid">
                  <div class="deep-dive-block">
                    <span class="deep-dive-label" data-lang-es="Pregunta de Investigación:" data-lang-en="Research Question:">Pregunta de Investigación:</span>
                    <p class="deep-dive-text">{pub.researchQuestion}</p>
                  </div>
                  <div class="deep-dive-block">
                    <span class="deep-dive-label" data-lang-es="Metodología & Identificación:" data-lang-en="Methodology & Identification:">Metodología & Identificación:</span>
                    <p class="deep-dive-text">{pub.methodology}</p>
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Working Papers (Investigación en Curso) -->
    <section style="margin-bottom: 4.5rem;">
      <div style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
        <h2 class="font-serif" style="font-size: 1.85rem;" data-lang-es="Documentos de Trabajo (Working Papers)" data-lang-en="Working Papers (Work in Progress)">Documentos de Trabajo (Working Papers)</h2>
        <p style="font-size: 0.92rem; color: var(--text-muted); margin-top: 0.25rem;" data-lang-es="Manuscritos en proceso de arbitraje por pares o revisión en comités editoriales." data-lang-en="Manuscripts under peer review or editorial evaluation.">
          Manuscritos en proceso de arbitraje por pares o revisión en comités editoriales.
        </p>
      </div>

      <div class="grid-2">
        {workingPapers.map((paper) => (
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span class="badge badge-q3 font-mono">{paper.category}</span>
                <span class="badge badge-status font-mono" style="font-size: 0.72rem;">{paper.year}</span>
              </div>
              <h3 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 0.4rem; line-height: 1.4;">
                {paper.title}
              </h3>
              <p style="font-size: 0.88rem; color: var(--accent-primary); font-weight: 600; margin-bottom: 0.5rem;">
                {paper.authors.join(', ')}
              </p>
              <p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.55; margin-bottom: 1rem;">
                {paper.abstract}
              </p>
            </div>
            <div style="border-top: 1px solid var(--border-subtle); padding-top: 0.5rem; font-size: 0.82rem; color: var(--text-muted);">
              <strong data-lang-es="Estado: " data-lang-en="Status: ">Estado: </strong><strong>{paper.status}</strong> · {paper.area}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Students & Advising (Tesis y Asesorías) -->
    <section id="students">
      <div style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
        <h2 class="font-serif" style="font-size: 1.85rem;" data-lang-es="Tesistas & Mentoría de Investigación" data-lang-en="Student Advising & Research Mentorship">Tesistas & Mentoría de Investigación</h2>
        <p style="font-size: 0.92rem; color: var(--text-muted); margin-top: 0.25rem;" data-lang-es="Tesis doctorales, de maestría y monografías de grado asesoradas en la Universidad Icesi y Universidad Nacional." data-lang-en="Doctoral dissertations, master's theses, and undergraduate monographs advised at Universidad Icesi and Universidad Nacional.">
          Tesis doctorales, de maestría y monografías de grado asesoradas en la Universidad Icesi y Universidad Nacional.
        </p>
      </div>

      <div class="table-responsive">
        <table class="academic-table">
          <thead>
            <tr>
              <th data-lang-es="Estudiante" data-lang-en="Student">Estudiante</th>
              <th data-lang-es="Programa" data-lang-en="Program">Programa</th>
              <th data-lang-es="Tema / Título de la Investigación" data-lang-en="Research Topic / Title">Tema / Título de la Investigación</th>
              <th data-lang-es="Año" data-lang-en="Year">Año</th>
              <th data-lang-es="Rol" data-lang-en="Role">Rol</th>
            </tr>
          </thead>
          <tbody>
            {supervisedStudents.map((s) => (
              <tr>
                <td style="font-weight: 700; color: var(--text-primary);">{s.name}</td>
                <td style="font-size: 0.88rem; color: var(--accent-primary);">{s.degree}</td>
                <td style="font-style: italic; font-size: 0.92rem;">"{s.thesis}"</td>
                <td style="font-family: var(--font-mono); font-size: 0.85rem;">{s.year}</td>
                <td><span class="badge badge-status font-mono" style="font-size: 0.72rem;">{s.role}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .archive-filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .filter-btn {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.4rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: var(--transition);
    font-family: var(--font-sans);
  }

  .filter-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent-primary);
  }

  .filter-btn.active {
    background: var(--accent-primary);
    color: #ffffff;
    border-color: var(--accent-secondary);
  }

  .pub-item {
    margin-bottom: 2rem;
  }

  .pub-deep-dive {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-top: none;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    padding: 1.15rem 1.5rem;
    margin-top: -1.5rem;
    margin-bottom: 1.5rem;
  }

  .deep-dive-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .deep-dive-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .deep-dive-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-primary);
  }

  .deep-dive-text {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .table-responsive {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-card);
  }

  .academic-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.92rem;
  }

  .academic-table th {
    background: var(--bg-tertiary);
    padding: 0.85rem 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-subtle);
  }

  .academic-table td {
    padding: 0.95rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: top;
  }

  .academic-table tr:last-child td {
    border-bottom: none;
  }

  @media (max-width: 768px) {
    .deep-dive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupArchiveFilter() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const pubItems = document.querySelectorAll('.pub-item');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';

        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        pubItems.forEach((item) => {
          const area = item.getAttribute('data-area');
          if (filter === 'all' || area === filter) {
            (item as HTMLElement).style.display = '';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupArchiveFilter();
  document.addEventListener('astro:after-swap', setupArchiveFilter);
</script>
